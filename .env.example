# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it is already in .gitignore.

# Flask signs the session cookie with this. Use a long random string.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Supabase project URL + API key (Project Settings → API).
# Use the anon/public key if Row Level Security is enabled.
# Use the service_role key ONLY on the server and NEVER in the browser.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Groq (question generation). Server-side only.
GROQ_API_KEY=gsk_your_groq_key

# Optional. Render sets PORT automatically.
# PORT=5000

# Set to production on Render/Vercel so Secure cookies can be enabled.
FLASK_ENV=development

# Set to true on HTTPS hosts (Render, custom domain) so the session
# cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=false
